generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  role               String              @default("CUSTOMER")
  createdAt          DateTime            @default(now())
  sessions           Session[]
  orders             Order[]
  notifications      Notification[]
  addresses          UserAddress[]
  orderEvents        OrderStatusEvent[]
  inventoryMovements InventoryMovement[]
}

model UserAddress {
  id            String   @id @default(cuid())
  label         String
  recipientName String
  phone         String
  city          String
  district      String
  ward          String
  address       String
  isDefault     Boolean  @default(false)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([userId, isDefault])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id                 String                 @id @default(cuid())
  name               String
  slug               String                 @unique
  sku                String                 @unique
  price              Decimal                @db.Decimal(12, 0)
  salePrice          Decimal?               @db.Decimal(12, 0)
  stock              Int                    @default(0)
  shortDescription   String?
  description        String?
  visible            Boolean                @default(true)
  categoryId         String
  brandId            String
  category           Category               @relation(fields: [categoryId], references: [id])
  brand              Brand                  @relation(fields: [brandId], references: [id])
  images             ProductImage[]
  specifications     ProductSpecification[]
  reviews            Review[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime               @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpecification {
  id        String  @id @default(cuid())
  name      String
  value     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  orders    Order[]
  reviews   Review[]
  createdAt DateTime @default(now())
}

model Order {
  id                  String               @id @default(cuid())
  code                String               @unique
  customerId          String
  customer            Customer             @relation(fields: [customerId], references: [id])
  userId              String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  status              OrderStatus          @default(PENDING)
  total               Decimal              @db.Decimal(12, 0)
  address             String
  note                String?
  paymentMethod       String
  paymentStatus       PaymentStatus        @default(PENDING)
  paymentRequired     Decimal              @default(0) @db.Decimal(12, 0)
  paidAmount          Decimal              @default(0) @db.Decimal(12, 0)
  paymentReference    String?              @unique
  paidAt              DateTime?
  installation        Boolean              @default(false)
  items               OrderItem[]
  notifications       Notification[]
  statusEvents        OrderStatusEvent[]
  inventoryMovements  InventoryMovement[]
  paymentTransactions PaymentTransaction[]
  cancelledAt         DateTime?
  cancellationReason  String?
  updatedAt           DateTime             @updatedAt
  createdAt           DateTime             @default(now())

  @@index([userId])
  @@index([customerId])
}

model PaymentTransaction {
  id                    String    @id @default(cuid())
  provider              String
  providerTransactionId String
  referenceCode         String?
  gateway               String
  accountNumber         String
  amount                Decimal   @db.Decimal(12, 0)
  transactionDate       DateTime?
  rawPayload            Json
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt             DateTime  @default(now())

  @@unique([provider, providerTransactionId])
  @@index([orderId, createdAt])
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([actorId])
}

enum InventoryMovementType {
  ORDER_RESERVED
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
}

model InventoryMovement {
  id         String                @id @default(cuid())
  productId  String
  orderId    String?
  actorId    String?
  type       InventoryMovementType
  quantity   Int
  stockAfter Int
  note       String?
  product    Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  order      Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor      User?                 @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([actorId])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  readAt    DateTime?
  userId    String
  orderId   String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([orderId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String   @default("")
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 0)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  content    String?
  approved   Boolean  @default(false)
  productId  String
  customerId String
  product    Product  @relation(fields: [productId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
}

model Promotion {
  id       String   @id @default(cuid())
  name     String
  code     String?
  discount Decimal  @db.Decimal(12, 0)
  startsAt DateTime
  endsAt   DateTime
  active   Boolean  @default(true)
}

model Banner {
  id       String  @id @default(cuid())
  title    String
  imageUrl String
  link     String?
  position Int     @default(0)
  active   Boolean @default(true)
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  coverUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StoreSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
}
